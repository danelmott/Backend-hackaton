# Copia a .env en local. En Render: Environment → Add Environment Variable

NODE_ENV=development
PORT=4000

# PostgreSQL (Supabase u otro)
DATABASE_URL=postgresql://user:pass@host:6543/db?pgbouncer=true
DIRECT_URL=postgresql://user:pass@host:5432/db

# JWT (secretos largos aleatorios, no hashes bcrypt)
ACCESS_SIGNATURE=
REFRESH_SIGNATURE=

# Frontend (CORS + redirecciones OAuth) — obligatorio en producción
CLIENT_URL=http://localhost:3000
# Producción: CLIENT_URL=https://tu-frontend.com

# API pública (opcional; en Render se usa RENDER_EXTERNAL_URL automático)
# API_URL=https://serfi-api.onrender.com

ANTHROPIC_API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# En Render: https://TU-SERVICIO.onrender.com/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
